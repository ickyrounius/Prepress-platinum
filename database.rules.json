{
  "rules": {
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$notificationId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['message', 'read', 'timestamp'])"
        }
      }
    },
    "locks": {
      ".read": "auth != null",
      "$jobId": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('activeUser/uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('activeUser/uid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['activeUser', 'timestamp']) && newData.child('activeUser/uid').isString() && newData.child('timestamp').isNumber()"
      }
    },
    "active_jobs": {
      ".read": "auth != null",
      "$collection": {
        "$jobId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['id']) && (newData.child('timestamp_update').exists() || newData.child('timestamp_input').exists() || newData.child('LAST_UPDATED').exists())"
        }
      }
    }
  }
}
